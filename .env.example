# Server-only runtime settings. Never place secrets in NEXT_PUBLIC_* variables.
WORKSPACE_MODE=true
# Начальные учётные записи (используются только при первом заполнении пустой базы):
# INITIAL_USERS=[{"id":"admin","name":"Администратор","role":"admin","password":"GENERATE_A_UNIQUE_PASSWORD"}]

# ИИ-модули. Без ключа работают проверки по правилам и статистика.
# AI_PROVIDER=claude            # claude | openai | openrouter | mock (mock — только для локальных тестов)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# LAN only: create ignored .dev.vars.lan-ai with AI_LAN_ENABLED=true, OPENROUTER_API_KEY and optional OPENROUTER_MODEL.

# Фоновые напоминания внешним планировщиком (на Cloudflare работает Cron Trigger).
# REMINDER_TOKEN=
# Адрес приложения для push-уведомлений из Cron.
# PUBLIC_ORIGIN=https://naryadai.example.workers.dev

# Выгрузка нарядов в 1С / ERP / ТОиР: GET /api/integration/orders (Authorization: Bearer …).
# INTEGRATION_TOKEN=

# Разрешение предприятия на передачу изображений внешней модели. По умолчанию фото проверяет мастер.
# AI_PHOTOS_APPROVED=true
